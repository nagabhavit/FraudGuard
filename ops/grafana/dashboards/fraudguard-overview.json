{
  "title": "FraudGuard Overview",
  "uid": "fraudguard-overview",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["fraudguard"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate, by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(fraudguard_http_request_duration_seconds_count[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p99 latency, by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(fraudguard_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "description": "Against the README's p99 <= 100ms hot-path budget for the gateway specifically -- the other three services have no such SLA of their own."
    },
    {
      "id": 3,
      "title": "Gateway decisions, by outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(fraudguard_gateway_decisions_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Degradation ladder: fallback rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(fraudguard_gateway_decisions_total{used_model=\"false\"}[15m])) / sum(rate(fraudguard_gateway_decisions_total[15m]))",
          "refId": "A"
        }
      ],
      "description": "Share of decisions made by the ADR-0009 fallback rule (used_model=\"false\") rather than the model, over the trailing 15 minutes. Should be ~0 -- a sustained nonzero value means feature-service or model-service is degraded."
    },
    {
      "id": 5,
      "title": "Gateway scoring duration (feature-service + model-service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fraudguard_gateway_scoring_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fraudguard_gateway_scoring_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Aggregator messages processed, by outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(fraudguard_aggregator_messages_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "description": "\"skipped\" is ADR-0008's poison-message handling -- a nonzero, sustained rate here means messages are being decoded-or-applied incorrectly, not just occasionally."
    }
  ]
}
