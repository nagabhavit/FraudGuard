# =============================================================================
# FraudGuard local development configuration
# =============================================================================
#
# Copy to .env and adjust as needed:
#
#     cp .env.example .env
#
# .env is gitignored. This file is the committed contract describing which
# variables exist and what they mean.
#
# Nothing here is a real secret and nothing here ever will be. These are local
# development values only. Production configuration comes from AWS Secrets
# Manager, injected as environment variables at pod startup (Milestone 29).
# =============================================================================

# ---- PostgreSQL -------------------------------------------------------------
# System of record: transactions, decisions, labels, model registry.
# POSTGRES_HOST is "localhost" for tools running on your host (Alembic, a
# locally-run gateway) and "postgres" inside docker-compose.yml, where the
# gateway container overrides it to reach Postgres by service name.
POSTGRES_HOST=localhost
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=fraudguard
POSTGRES_DB=fraudguard
POSTGRES_PORT=5432

# ---- Redis ------------------------------------------------------------------
# Online feature store and sliding-window counters.
# Note the noeviction policy in docker-compose.yml: silently evicting a
# velocity counter would corrupt a fraud decision, so we would rather fail.
# REDIS_HOST is "localhost" for tools running on your host and "redis" inside
# docker-compose.yml, where the feature-service container overrides it to
# reach Redis by service name -- same split as POSTGRES_HOST.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ------------------------------------------------------------------
# Durable event log. Containers reach the broker on kafka:9092; tools running
# on your host use the external listener below.
KAFKA_EXTERNAL_PORT=29092
# KAFKA_BOOTSTRAP_SERVERS is what fraudguard-events actually connects to.
# Same host/container split as POSTGRES_HOST: this is the host-side value;
# the gateway container overrides it to "kafka:9092".
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ---- Schema Registry --------------------------------------------------------
# Enforces BACKWARD compatibility on every Avro schema change.
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_URL=http://localhost:8081

# ---- Application services ---------------------------------------------------
GATEWAY_PORT=8000
FEATURE_SERVICE_PORT=8001
AGGREGATOR_PORT=8002
MODEL_SERVICE_PORT=8003
DASHBOARD_PORT=8080
# The one browser origin the gateway's CORS policy allows to call
# GET /v1/transactions (ADR-0012). Always the host-mapped port above -- CORS
# is enforced against the origin the browser loaded the page from, which is
# never the internal docker-compose service name.
DASHBOARD_ORIGIN=http://localhost:8080

# ---- Observability (ADR-0010) ------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Logging ----------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
